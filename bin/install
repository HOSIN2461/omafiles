#!/usr/bin/env sh
# Install the working tree for daily use, user-locally and alongside whatever
# file manager you already have: a symlink to the build (so later rebuilds are
# picked up without reinstalling), the desktop entry, the icon, the helper
# scripts, and any context-menu actions you do not already have.
#
# Nothing here touches /usr or pacman. The real package builds from the release
# tag: cd packaging && makepkg -si
#
# OMAFILES_PREFIX=~/.local by default.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PREFIX="${OMAFILES_PREFIX:-$HOME/.local}"
ACTIONS_DIR="${OMAFILES_ACTIONS_DIR:-$HOME/.config/omafiles/actions}"

"$ROOT/bin/build"

mkdir -p "$PREFIX/bin" "$PREFIX/share/applications" \
  "$PREFIX/share/icons/hicolor/scalable/apps" "$ACTIONS_DIR"

ln -sfn "$ROOT/build/omafiles" "$PREFIX/bin/omafiles"
install -m755 "$ROOT/packaging/bin/omafiles-switch" "$ROOT/packaging/bin/omafiles-launch" \
  "$ROOT/packaging/bin/omafiles-launch-cwd" "$ROOT/packaging/bin/omafiles-dropbox-link" \
  "$PREFIX/bin/"
install -m644 "$ROOT/packaging/omafiles.desktop" "$PREFIX/share/applications/omafiles.desktop"
install -m644 "$ROOT/packaging/omafiles.svg" \
  "$PREFIX/share/icons/hicolor/scalable/apps/omafiles.svg"

# Actions are yours to edit once installed, so never overwrite an existing one.
for action in "$ROOT"/packaging/actions/*.toml; do
  target="$ACTIONS_DIR/$(basename "$action")"
  [ -e "$target" ] || install -m644 "$action" "$target"
done

update-desktop-database -q "$PREFIX/share/applications" >/dev/null 2>&1 || true
gtk-update-icon-cache -q -t -f "$PREFIX/share/icons/hicolor" >/dev/null 2>&1 || true

echo "Installed to $PREFIX (omafiles -> $ROOT/build/omafiles)"
case ":$PATH:" in
  *":$PREFIX/bin:"*) ;;
  *) echo "Note: $PREFIX/bin is not on your PATH." >&2 ;;
esac
