# omafiles — natív Qt Quick/GIO fájlkezelő Omarchy-hoz.
#
# Verziószámos build. Helyi teszt buildhez cseréld ki a source= sort:
#   source=("$pkgname::git+file://<repo-útmutató>")
# És add hozzá:
#   pkgver() { cd "$pkgname"; printf "0.r%s.%s" \
#     "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"; }

pkgname=omafiles
pkgver=0.4.5
pkgrel=1
pkgdesc="Magyar fájlkezelő Omarchy-hoz (Qt Quick + GIO)"
arch=('x86_64')
url="https://github.com/HOSIN2461/omafiles"
license=('MIT')
install="$pkgname.install"
depends=('qt6-base' 'qt6-declarative' 'glib2' 'gvfs' 'hicolor-icon-theme'
         'libarchive' 'tinysparql' 'curl' 'pacman')
optdepends=('gvfs-smb: smb:// megosztások böngészése'
            'gvfs-mtp: telefonok MTP-n keresztül'
            'gvfs-gphoto2: kamerák'
            'ffmpegthumbnailer: videó miniatűrök'
            'localsearch: teljes szöveges keresés')
makedepends=('cmake' 'ninja' 'git')
source=("$pkgname::git+https://github.com/HOSIN2461/omafiles.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
    cmake -S "$pkgname" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DOMAFILES_BUILD_TESTS=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
